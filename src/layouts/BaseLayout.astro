---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';
import '@fontsource/mulish/600.css';
import '@fontsource/mulish/700.css';
import '@fontsource/prata/400.css';
import '../styles/global.css';
// Logo chiaro del cliente per l'apertura: inline (data URI, ~5 KB) cosi' e'
// gia' nell'HTML al primo paint e l'animazione non aspetta una richiesta.
import logoIntro from '../assets/img/logo-chiaro.png?inline';

// Font della prima schermata: preload per evitare il reflow da font-swap.
// Senza, il cambio di famiglia sposta H1/logo (CLS misurato 0.058).
import cormorant500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
// poppins700/mulish700: niente preload, pesano sulla banda mobile senza toccare il CLS

const fontCritici = [cormorant500, poppins400];

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, progetti } from '../data/landing';

interface Props {
  title: string;
  description: string;
  /** Percorso relativo, sempre con slash finale: convenzione unica di tutto il sito. */
  path?: string;
  ogImage?: string;
}

const { title, description, path = '/', ogImage = '/og-default.jpg' } = Astro.props;

const canonical = new URL(path, site.dominio).href;
const ogImageUrl = new URL(ogImage, site.dominio).href;

const studio = {
  '@type': 'ProfessionalService',
  '@id': `${site.dominio}/#studio`,
  name: site.nome,
  description,
  url: `${site.dominio}/`,
  email: site.email,
  telephone: site.telefonoE164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.via,
    addressLocality: site.citta,
    postalCode: site.cap,
    addressRegion: site.provincia,
    addressCountry: 'IT',
  },
  areaServed: site.areeServite,
  // Orari della pagina Contatti (Lun-Ven 9-18, Sabato 9-13, Domenica chiuso).
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '13:00' },
  ],
  // Il sito non nomina un titolare: niente `founder`, che con la firma
  // "Studio Tecnico Bignami" descriverebbe lo studio come una persona.
  sameAs: [site.social.instagram, site.social.facebook].filter(Boolean),
};

// Un Service per ciascuno dei servizi in vetrina.
const opere = progetti.map((p) => ({
  '@type': 'Service',
  name: p.titolo,
  description: p.localita,
  url: new URL(p.href, site.dominio).href,
  category: p.categoria,
  areaServed: site.areeServite,
  provider: { '@id': `${site.dominio}/#studio` },
}));

const jsonLd = { '@context': 'https://schema.org', '@graph': [studio, ...opere] };
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    {/* viewport senza user-scalable=no: lo zoom resta disponibile */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {fontCritici.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Segue --color-brand di global.css (e theme_color in site.webmanifest): si cambia insieme alla palette. */}
    <meta name="theme-color" content="#1987c6" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="1000" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon-32.jpg" sizes="32x32" />
    <link rel="icon" href="/icon-192.jpg" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline define:vars={{ home: path === '/' }}>
      // Attiva lo stato iniziale dei reveal solo se il JS gira davvero.
      document.documentElement.classList.add('js');
      // L'apertura si vede una volta per sessione. La decisione va presa qui,
      // nell'head: se aspettasse il bundle, le ante resterebbero chiuse per
      // tutto il tempo di download e ritarderebbero FCP e LCP.
      try {
        if (!home) {
          // Pagina interna (es. privacy): niente apertura, e il flag resta
          // libero per la prima visita alla home.
          document.documentElement.classList.add('no-intro');
        } else if (sessionStorage.getItem('sb-intro') === '1') {
          document.documentElement.classList.add('no-intro');
        } else {
          sessionStorage.setItem('sb-intro', '1');
        }
      } catch (e) {
        document.documentElement.classList.add('no-intro');
      }
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body data-view="landing">
    {/* Apertura: ad ante chiuse si compone il logo (segno RB, barra, scritta),
        poi le ante si scostano sull'hero. Tre copie della stessa immagine,
        ognuna ritagliata su un pezzo del logo: vedi .intro-logo in global.css. */}
    {path === '/' && (
    <div id="intro" aria-hidden="true">
      <span class="intro-anta" data-intro-anta="sx"></span>
      <span class="intro-anta" data-intro-anta="dx"></span>
      <span class="intro-riga" data-intro-riga></span>
      <span class="intro-logo">
        <img class="intro-logo-segno" src={logoIntro} width="305" height="65" alt="" />
        <img class="intro-logo-barra" src={logoIntro} width="305" height="65" alt="" />
        <img class="intro-logo-scritta" src={logoIntro} width="305" height="65" alt="" />
      </span>
    </div>
    )}

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-5 focus:py-3 focus:text-sm focus:text-white"
    >
      Salta al contenuto
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
