---
import { site } from '../../data/landing';
import Mappa from './Mappa.astro';
import Form from './Form.astro';
---

<section id="contatti" data-section data-dark class="bg-[var(--color-ink)] py-20 text-white md:py-28">
  <div class="container-content grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-20">
    <div>
      <h2 class="text-[clamp(30px,4.2vw,56px)] text-white" data-reveal data-reveal-delay="0.08">
        Contattaci
      </h2>
      <p class="mt-5 max-w-[46ch] text-white/70" data-reveal data-reveal-delay="0.14">
        Contatti per maggiori informazioni o per richiedere un preventivo gratuito.
      </p>
      <a
        href="#contatti"
        data-nav-anchor
        data-nav-link="#contatti"
        data-landing-only
        class="btn btn-primary mt-9"
        data-reveal
        data-reveal-delay="0.2"
      >
        <span>Richiedi preventivo</span>
      </a>
      <a href={`tel:${site.telefonoE164}`} data-tab-only class="btn btn-primary mt-9" data-reveal data-reveal-delay="0.2">
        Chiama lo studio
      </a>
    </div>

    <address class="not-italic" data-reveal data-reveal-delay="0.1">
      <p class="eyebrow mb-5">Sede Operativa</p>
      <dl class="grid gap-7 border-t border-white/15 pt-7">
        <div>
          <dt class="mono-meta text-white/60">Studio</dt>
          <dd class="mt-1 font-[family-name:var(--font-display)] text-2xl">{site.indirizzo}</dd>
        </div>
        <div>
          <dt class="mono-meta text-white/60">Telefono</dt>
          <dd class="mt-1 font-[family-name:var(--font-display)] text-2xl">
            <a href={`tel:${site.telefonoE164}`} class="transition-colors hover:text-[var(--color-brand)]">
              {site.telefono}
            </a>
          </dd>
        </div>
        <div>
          <dt class="mono-meta text-white/60">Email</dt>
          <dd class="mt-1 font-[family-name:var(--font-display)] text-2xl">
            <a href={`mailto:${site.email}`} class="transition-colors hover:text-[var(--color-brand)]">
              {site.email}
            </a>
          </dd>
        </div>
      </dl>
    </address>
  </div>

  {/* Anteprima: dove siamo, con la mappa. Il form e' la cosa in piu' della scheda. */}
  <div data-landing-only class="container-content mt-12" data-reveal data-reveal-delay="0.16">
    <Mappa />
  </div>

  <div data-tab-only class="container-content mt-14 grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <div>
      <h3 class="text-[clamp(22px,2.4vw,30px)] text-white" data-reveal>Richiedi preventivo</h3>
      <p class="mono-meta mt-2 text-white/60" data-reveal data-reveal-delay="0.05">
        Apertura Ufficio: {site.orari}
      </p>
      <div class="mt-7" data-reveal data-reveal-delay="0.1">
        <Form />
      </div>
    </div>

    <div data-reveal data-reveal-delay="0.14">
      <Mappa />
    </div>
  </div>
</section>
