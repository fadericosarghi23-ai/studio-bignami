---
import { Image } from 'astro:assets';
import { fasi } from '../../data/landing';

// Una foto per fase; la 02 fa anche da sfondo velato dell'anteprima.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/fase-*.jpg', {
  eager: true,
});
const img = (name: string) => files[`../../assets/img/${name}`].default;
---

<section id="metodo" data-section class="relative overflow-hidden py-16 md:py-20">
  {/* Sfondo fotografico dell'anteprima: e' una delle foto del metodo,
      velata quel tanto che basta a tenere il testo bianco sopra la soglia AA. */}
  <div data-landing-only class="absolute inset-0" aria-hidden="true">
    <Image
      src={img('fase-02.jpg')}
      alt=""
      widths={[768, 1280, 1800]}
      sizes="100vw"
      class="h-full w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-[var(--color-ink)]/88"></div>
  </div>

  <div class="container-content relative">
    <header class="max-w-3xl">
      <p class="eyebrow" data-reveal>I nostri valori</p>
      <h2
        class="mt-4 text-[clamp(30px,4.2vw,56px)] [body[data-view=landing]_&]:text-white"
        data-reveal
        data-reveal-delay="0.06"
      >
        Come lavoriamo
      </h2>
      <p
        class="mt-5 max-w-[52ch] [body[data-view=landing]_&]:text-white/80"
        data-reveal
        data-reveal-delay="0.12"
      >
        Siamo un team esperto e dedicato, pronto ad assisterti in ogni fase del processo, dal concept alla realizzazione finale.
      </p>
    </header>

    {/* Anteprima: quattro card che entrano una dopo l'altra sullo sfondo */}
    <ol data-landing-only class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        fasi.map((fase, i) => (
          <li data-reveal data-reveal-delay={(i * 0.09).toFixed(2)}>
            <div class="metodo-card flex h-full flex-col border border-white/15 bg-white/[0.04] p-6">
              <span class="font-[family-name:var(--font-display)] text-[38px] leading-none text-[var(--color-brand)]">
                {fase.n}
              </span>
              <span class="mt-3 block font-[family-name:var(--font-display)] text-[22px] leading-tight text-white">
                {fase.titolo}
              </span>
              <span class="mt-3 block text-[14px] leading-6 text-white/70">{fase.testo}</span>
            </div>
          </li>
        ))
      }
    </ol>

    <a
      href="#metodo"
      data-nav-anchor
      data-nav-link="#metodo"
      data-landing-only
      class="btn btn-light mt-9"
      data-reveal
      data-reveal-delay="0.42"
    >
      Scopri i valori
    </a>
  </div>

  {/*
    Scheda: le quattro fasi scorrono in orizzontale mentre la pagina resta
    bloccata, con una barra che dice a che punto si e'. Sotto i 1025px, e con
    prefers-reduced-motion, il binario torna una pila verticale e si scorre
    normalmente: il contenuto e' lo stesso, cambia solo come lo si attraversa.
  */}
  <div data-tab-only class="mt-12">
    <div data-binario-scena>
      <div data-binario-pin>
        <ol data-binario class="container-content lg:pr-[8vw]">
          {
            fasi.map((fase) => (
              <li class="flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-10">
                <figure class="overflow-hidden lg:w-[46%] lg:shrink-0" data-reveal-clip>
                  <Image
                    src={img(fase.img)}
                    alt={fase.alt}
                    widths={[420, 640, 900]}
                    sizes="(min-width: 1025px) 400px, 92vw"
                    class="h-[240px] w-full object-cover md:h-[300px] lg:h-[420px]"
                    loading="lazy"
                  />
                </figure>

                <div class="lg:flex-1">
                  <div class="flex items-baseline gap-5">
                    <span class="font-[family-name:var(--font-display)] text-[clamp(44px,6vw,86px)] leading-none text-[var(--color-brand-ink)]">
                      {fase.n}
                    </span>
                    <span class="rule hidden flex-1 lg:block"></span>
                  </div>
                  <h3 class="mt-4 text-[clamp(26px,3.2vw,40px)]">{fase.titolo}</h3>
                  <p class="mt-4 max-w-[46ch] text-[17px]">{fase.testo}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="container-content mt-10 hidden lg:block">
          <div class="h-px w-full bg-[var(--color-line)]">
            <span data-binario-avanzamento aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="container-content mt-12 flex justify-center">
      <a href="#mission" data-nav-anchor data-nav-link="#mission" class="btn btn-outline">Lo studio</a>
    </div>
  </div>
</section>

<style>
  /* Le card si sollevano appena: il movimento sta nell'ingresso, non nell'hover. */
  .metodo-card {
    transition:
      background-color 0.45s var(--ease-reveal),
      border-color 0.45s var(--ease-reveal),
      transform 0.45s var(--ease-reveal);
  }
  .metodo-card:hover {
    background-color: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.3);
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .metodo-card {
      transition: none;
    }
    .metodo-card:hover {
      transform: none;
    }
  }
</style>
